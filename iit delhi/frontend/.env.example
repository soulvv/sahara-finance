# ==============================================================================
# SAHARA FINANCE FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# Backend API Base URL
# Leave empty ("") when using Vite proxy in local dev, or set to public backend URL in production
# Example for Render deployment: https://sahara-finance-api.onrender.com
VITE_API_BASE_URL=

# App Metadata
VITE_APP_TITLE=Sahara Finance
VITE_APP_ENV=production
