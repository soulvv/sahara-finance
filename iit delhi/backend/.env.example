# ==============================================================================
# SAHARA FINANCE BACKEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# MongoDB Database Connection
# For Local Development: mongodb://127.0.0.1:27017/sahara_finance
# For Production (MongoDB Atlas Free M0): mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/sahara_finance?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sahara_finance

# JWT Authentication (Set a random high-entropy secret with at least 32 characters in production)
JWT_SECRET=change_this_to_a_secure_random_32_character_secret_key_in_production
JWT_EXPIRES_IN=7d

# Free Demo OTP vs Real SMS Configuration
# Mode: "demo" (free prototype mode without SMS costs) | "sms" (requires paid SMS gateway)
OTP_MODE=demo
OTP_DEV_MODE=true
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Allowed Client Origins for CORS (comma-separated for multiple domains)
# Example: https://sahara-finance.pages.dev,https://sahara-finance.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# OmniDimension AI Voice Assistant (Phase 7 Integration)
OMNIDIM_MODE=mock
OMNIDIM_API_KEY=
OMNIDIM_BASE_URL=https://api.omnidimension.ai/v1
